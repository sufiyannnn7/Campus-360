# Campus 360 Environment Configuration Example
# Copy to .env or .env.local to customize your environment

# API Base URL for backend requests
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_NAME="Campus 360"
VITE_APP_VERSION=1.0.0

# Mock and Development Toggles
VITE_ENABLE_MOCK_FALLBACK=true
VITE_MOCK_LATENCY_MS=150

# Optional Supabase Integration (Leave blank to use mock backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
